{
  "rules": {
    ".read": false,
    ".write": false,
    "clockSync": {
      "$sample": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "$sample.matches(/^[-_0-9A-Za-z]{20}$/) && newData.isNumber() && newData.val() <= now && newData.val() >= now - 1000"
      }
    },
    "timers": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$viewId": {
        ".write": "newData.exists() && newData.parent().parent().child('views/' + $viewId).isString() && newData.parent().parent().child('manage/' + newData.parent().parent().child('views/' + $viewId).val() + '/version').val() === newData.child('version').val() && (!data.exists() || newData.child('version').val() > data.child('version').val())",
        ".validate": "newData.hasChildren(['title', 'status', 'durationMs', 'remainingMs', 'version', 'createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(idle|running|paused|finished)$/)"
        },
        "durationMs": {
          ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 359999000"
        },
        "remainingMs": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 359999000"
        },
        "endsAt": {
          ".validate": "newData.isNumber() && newData.parent().child('status').val() === 'running'"
        },
        "version": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "views": {
      "$viewId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$viewId.matches(/^[2-9a-hjkmnp-z]{8}$/) && newData.isString() && newData.parent().parent().child('manage/' + newData.val() + '/viewId').val() === $viewId"
      }
    },
    "manage": {
      "$manageId": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "$manageId.matches(/^[-_0-9A-Za-z]{20}$/) && newData.hasChildren(['viewId', 'version'])",
        "viewId": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.parent().parent().parent().child('views/' + newData.val()).val() === $manageId)"
        },
        "version": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() > data.val() : newData.val() === 0)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "previews": {
      "$preview": {
        ".validate": "$preview.matches(/^pr-[0-9]+$/)",
        "timers": {
          ".read": true,
          ".indexOn": [
            "createdAt"
          ],
          "$viewId": {
            ".write": "newData.exists() && newData.parent().parent().child('views/' + $viewId).isString() && newData.parent().parent().child('manage/' + newData.parent().parent().child('views/' + $viewId).val() + '/version').val() === newData.child('version').val() && (!data.exists() || newData.child('version').val() > data.child('version').val())",
            ".validate": "newData.hasChildren(['title', 'status', 'durationMs', 'remainingMs', 'version', 'createdAt'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(idle|running|paused|finished)$/)"
            },
            "durationMs": {
              ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 359999000"
            },
            "remainingMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 359999000"
            },
            "endsAt": {
              ".validate": "newData.isNumber() && newData.parent().child('status').val() === 'running'"
            },
            "version": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "views": {
          "$viewId": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "$viewId.matches(/^[2-9a-hjkmnp-z]{8}$/) && newData.isString() && newData.parent().parent().child('manage/' + newData.val() + '/viewId').val() === $viewId"
          }
        },
        "manage": {
          "$manageId": {
            ".read": true,
            ".write": "newData.exists()",
            ".validate": "$manageId.matches(/^[-_0-9A-Za-z]{20}$/) && newData.hasChildren(['viewId', 'version'])",
            "viewId": {
              ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.parent().parent().parent().child('views/' + newData.val()).val() === $manageId)"
            },
            "version": {
              ".validate": "newData.isNumber() && (data.exists() ? newData.val() > data.val() : newData.val() === 0)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
